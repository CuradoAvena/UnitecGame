using UnityEngine;
using UnityEngine.InputSystem;

[RequireComponent(typeof(Collider))]
public sealed class DraggablePiece : MonoBehaviour
{
    [Header("Setup")]
    [SerializeField] private Transform targetSnapPoint;
    [SerializeField] private float snapDistance = 1.5f;

    private Camera mainCamera;
    private bool isDragging;
    private float zCoordinate;
    private Vector3 mouseOffset;
    private bool isSnapped;

    // Referencias al New Input System de Unity 6
    private Mouse currentMouse;
    private Touchscreen currentTouch;

    void Start()
    {
        mainCamera = Camera.main;
        currentMouse = Mouse.current;
        currentTouch = Touchscreen.current;
    }

    void Update()
    {
        if (isSnapped) return;

        HandleInput();
    }

    private void HandleInput()
    {
        // 1. Detectar el inicio del clic o toque
        if (GetSelectPressedThisFrame())
        {
            Vector2 screenPosition = GetCurrentScreenPosition();
            Ray ray = mainCamera.ScreenPointToRay(screenPosition);

            if (Physics.Raycast(ray, out RaycastHit hit))
            {
                // Verificamos si el raycast golpeó este objeto específico
                if (hit.transform == transform)
                {
                    StartDrag(screenPosition);
                }
            }
        }

        // 2. Procesar el arrastre sostenido
        if (isDragging && GetSelectIsHeld())
        {
            Vector2 screenPosition = GetCurrentScreenPosition();
            Vector3 mousePoint = new Vector3(screenPosition.x, screenPosition.y, zCoordinate);
            transform.position = mainCamera.ScreenToWorldPoint(mousePoint) + mouseOffset;
