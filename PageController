using UnityEngine;
using UnityEngine.UI;

public sealed class PageController : MonoBehaviour
{
    [Header("Configuración de Páginas")]
    [Tooltip("Arrastra aquí todas las páginas en orden (0, 1, 2...)")]
    [SerializeField] private GameObject[] pages;

    [Header("Botones de Navegación")]
    [SerializeField] private Button nextButton;
    [SerializeField] private Button prevButton;

    private int currentPageIndex = 0;

    void Start()
    {
        // Inicializa el libro en la primera página
        if (pages.Length > 0)
        {
            ShowPage(0);
        }
        else
        {
            Debug.LogWarning("[DevLog] No has asignado páginas al array.");
        }
    }

    // Método para el botón Siguiente
    public void NextPage()
    {
        if (currentPageIndex < pages.Length - 1)
        {
            ShowPage(currentPageIndex + 1);
        }
    }

    // Método para el botón Anterior
    public void PreviousPage()
    {
        if (currentPageIndex > 0)
        {
            ShowPage(currentPageIndex - 1);
        }
    }

    private void ShowPage(int targetIndex)
    {
        // 1. Apagamos la página actual
        pages[currentPageIndex].SetActive(false);

        // 2. Actualizamos el índice y prendemos la nueva
        currentPageIndex = targetIndex;
        pages[currentPageIndex].SetActive(true);

        // 3. Evaluamos si los botones deben estar encendidos o apagados
        UpdateNavigationButtons();
    }

    private void UpdateNavigationButtons()
    {
        // Desactiva el botón "Anterior" si estamos en la página 0
        if (prevButton != null)
            prevButton.interactable = (currentPageIndex > 0);

        // Desactiva el botón "Siguiente" si estamos en la última página
        if (nextButton != null)
            nextButton.interactable = (currentPageIndex < pages.Length - 1);
    }
}
